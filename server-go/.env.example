# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=maliketh
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=maliketh

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Admin API Server
ADMIN_HOST=0.0.0.0
ADMIN_PORT=5000

# C2 Server
C2_HOST=0.0.0.0
C2_PORT=8080
C2_PROFILE=/app/configs/profile.example.yaml

# Operator Authentication
# Base64-encoded server private key for decrypting operator signatures
SERVER_PRIVATE_KEY=

# Implant Builder
CPP_IMPLANT_DIR=/implant
GO_IMPLANT_DIR=/go_implant

# Logging
LOG_LEVEL=info
ENV=development
